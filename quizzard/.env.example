# Database - Neon PostgreSQL
# DATABASE_URL is the pooled connection (PgBouncer) used by the running app.
# DIRECT_URL is the direct connection used by `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Session
# Generate with: openssl rand -base64 32
SESSION_SECRET=<your-secure-random-string-min-32-chars>

# AI Providers (at least one is required)
# OpenRouter - Access to many models including free ones
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash

# Google Gemini - Simple and capable
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.6-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Storage - Vercel Blob (public store)
# Created automatically when a Blob store is attached to the Vercel project
BLOB_READ_WRITE_TOKEN=<your-vercel-blob-read-write-token>

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional: Logging
LOG_LEVEL=info
