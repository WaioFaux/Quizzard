# Database - Neon PostgreSQL
# DATABASE_URL is the pooled connection (PgBouncer) used by the running app.
# DIRECT_URL is the direct connection used by `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Session
# Generate with: openssl rand -base64 32
SESSION_SECRET=<your-secure-random-string-min-32-chars>

# AI Providers (at least one is required)
# The app talks to Gemini first (model id comes from GEMINI_MODEL). When Gemini
# is overloaded it answers 503, and the request is then served by the other
# configured provider instead of failing.
# OpenRouter - Access to many models including free ones
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_DEFAULT_MODEL=baidu/ernie-5.5-flash-preview:free

# Google Gemini - Primary provider
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated Gemini models tried, in order, when GEMINI_MODEL
# is overloaded (503) or its quota is exhausted (429). Leave empty to try
# only GEMINI_MODEL.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# Optional: Hard timeout (ms) for a single AI provider call.
# Bounds how long a stalled provider can hold a serverless function.
AI_REQUEST_TIMEOUT_MS=20000

# Optional: Total budget (ms) for one logical AI call, covering every retry
# and the fallback to the second provider. Keep it below the serverless
# function limit (60s on Vercel Hobby) so the client always gets a real
# error message instead of a dropped connection.
AI_TOTAL_BUDGET_MS=45000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Storage - Vercel Blob (public store)
# Created automatically when a Blob store is attached to the Vercel project
BLOB_READ_WRITE_TOKEN=<your-vercel-blob-read-write-token>

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional: Logging
LOG_LEVEL=info
